{
  "manifest_version": 3,
  "name": "FollowTidy",
  "version": "0.3.0",
  "version_name": "0.3.0 free beta",
  "description": "Review your Instagram following list and unfollow selected accounts. Free, with no app usage cap.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "Open FollowTidy"
  },
  "background": {
    "service_worker": "background.js"
  }
}
